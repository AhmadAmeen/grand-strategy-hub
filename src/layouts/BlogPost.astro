---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'articles'>['data'];

const { title, description, date, category } = Astro.props;
---

<html lang="en">
	<head>
		<BaseHead title={`${title} | Grand Strategy Hub`} description={description} />
		<style>
			main {
				width: calc(100% - 2em);
				max-width: 100%;
				margin: 0;
			}
			.prose {
				width: 720px;
				max-width: calc(100% - 2em);
				margin: auto;
				padding: 1em;
			}
			.title {
				margin-bottom: 2em;
				padding: 2em 0;
				text-align: center;
				line-height: 1.2;
				border-bottom: 1px solid var(--border-color);
			}
			.title h1 {
				margin: 0.5em 0 0.5em 0;
				font-size: 2.2em;
			}
			.date {
				margin-bottom: 0.5em;
				color: var(--text-muted);
				font-size: 0.9em;
			}
			.category {
				display: inline-block;
				margin-bottom: 0.5em;
				padding: 0.25em 0.75em;
				border-radius: 4px;
				font-size: 0.8em;
				font-weight: 700;
				letter-spacing: 0.05em;
				text-transform: uppercase;
				text-decoration: none;
			}
			.category.eu4 {
				background: rgba(74, 125, 255, 0.15);
				color: var(--cat-eu4);
				border: 1px solid rgba(74, 125, 255, 0.3);
			}
			.category.eu5 {
				background: rgba(45, 212, 191, 0.15);
				color: var(--cat-eu5);
				border: 1px solid rgba(45, 212, 191, 0.3);
			}
			.category.ck3 {
				background: rgba(224, 82, 82, 0.15);
				color: var(--cat-ck3);
				border: 1px solid rgba(224, 82, 82, 0.3);
			}
			.category.comparisons {
				background: rgba(167, 139, 250, 0.15);
				color: var(--cat-comparisons);
				border: 1px solid rgba(167, 139, 250, 0.3);
			}
			@media (max-width: 720px) {
				.title h1 {
					font-size: 1.6em;
				}
			}
		</style>
	</head>

	<body>
		<Header />
		<main>
			<article>
				<div class="prose">
					<div class="title">
						<div class="date">
							<a class={`category ${category.toLowerCase()}`} href={`/category/${category.toLowerCase()}`}>{category}</a>
							<FormattedDate date={date} />
						</div>
						<h1>{title}</h1>
					</div>
					<slot />
				</div>
			</article>
		</main>
		<Footer />
	</body>
</html>