---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav>
		<h2><a href="/">{SITE_TITLE}</a></h2>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/quiz">Quiz</HeaderLink>
			<HeaderLink href="/category/eu5">EU5</HeaderLink>
			<HeaderLink href="/category/eu4">EU4</HeaderLink>
			<HeaderLink href="/category/ck3">CK3</HeaderLink>
			<HeaderLink href="/category/comparisons">Comparisons</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		position: sticky;
		top: 0;
		z-index: 100;
		margin: 0;
		padding: 0 1em;
		background: rgba(15, 20, 32, 0.9);
		backdrop-filter: blur(10px);
		border-bottom: 1px solid var(--border-color);
	}
	h2 {
		margin: 0;
		font-size: 1.1em;
		letter-spacing: 0.05em;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		color: var(--accent);
		font-weight: 700;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		flex-wrap: wrap;
		max-width: 960px;
		margin: 0 auto;
	}
	nav a {
		padding: 1em 0.5em;
		color: var(--text-secondary);
		border-bottom: 3px solid transparent;
		text-decoration: none;
		transition: color 0.2s ease, border-color 0.2s ease;
	}
	nav a:hover {
		color: var(--text-primary);
	}
	nav a.active {
		color: var(--accent);
		border-bottom-color: var(--accent);
	}
	.internal-links {
		display: flex;
		flex-wrap: wrap;
	}
	@media (max-width: 720px) {
		nav {
			justify-content: center;
		}
		h2 {
			width: 100%;
			text-align: center;
			padding: 0.5em 0;
		}
		nav a {
			padding: 0.75em 0.4em;
			font-size: 0.9em;
		}
	}
</style>