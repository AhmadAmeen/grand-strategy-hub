---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';

export function getStaticPaths() {
	const CATEGORY_MAP: Record<string, string> = {
		eu5: 'EU5',
		eu4: 'EU4',
		ck3: 'CK3',
		comparisons: 'Comparisons',
	};
	return Object.keys(CATEGORY_MAP).map((key) => ({
		params: { category: key },
	}));
}

const CATEGORY_NAMES: Record<string, string> = {
	eu5: 'EU5',
	eu4: 'EU4',
	ck3: 'CK3',
	comparisons: 'Comparisons',
};

const { category } = Astro.params;
const categoryName = CATEGORY_NAMES[category ?? ''] ?? 'Articles';
const posts = (await getCollection('articles'))
	.filter((post) => post.data.category === categoryName)
	.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`${categoryName} Guides | Grand Strategy Hub`} description={`${categoryName} guides and mechanics explainers for Paradox grand strategy games.`} />
		<style>
			h1 {
				margin-bottom: 1.5em;
				text-align: center;
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.5em;
			}
			@media (max-width: 720px) {
				.grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>{categoryName} Guides</h1>
			{posts.length === 0 ? (
				<p>No articles in this category yet. Check back soon!</p>
			) : (
				<div class="grid">
					{posts.map((post) => (
						<a class="article-card" href={`/blog/${post.data.slug}/`}>
							<span class={`cat-badge ${post.data.category.toLowerCase()}`}>{post.data.category}</span>
							<h4>{post.data.title}</h4>
							<p class="date">
								<FormattedDate date={post.data.date} />
							</p>
						</a>
					))}
				</div>
			)}
		</main>
		<Footer />
	</body>
</html>