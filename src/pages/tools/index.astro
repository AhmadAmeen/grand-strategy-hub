---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title="Tools | Grand Strategy Hub" description="Interactive tools for Paradox grand strategy games — explore trade networks, compare games, and more." />
		<style>
			h1 {
				text-align: center;
				margin-bottom: 0.5em;
			}
			.subtitle {
				text-align: center;
				color: var(--text-secondary);
				margin-bottom: 2em;
			}
			.tools-grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.5em;
			}
			.tool-card {
				background: var(--bg-card);
				border: 1px solid var(--border-color);
				border-radius: 12px;
				padding: 1.5em;
				text-decoration: none;
				transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
				position: relative;
				overflow: hidden;
				display: block;
			}
			.tool-card::before {
				content: '';
				position: absolute;
				top: 0;
				left: 0;
				right: 0;
				height: 4px;
				background: linear-gradient(90deg, var(--cat-eu4), rgba(74, 125, 255, 0.3));
			}
			.tool-card:hover {
				transform: translateY(-4px);
				box-shadow: var(--box-shadow-hover);
				border-color: var(--border-light);
			}
			.tool-card h3 {
				margin: 0.5em 0 0.5em 0;
				color: var(--text-primary);
				font-size: 1.2em;
				transition: color 0.2s ease;
			}
			.tool-card:hover h3 {
				color: var(--accent);
			}
			.tool-card p {
				margin: 0;
				color: var(--text-secondary);
				font-size: 0.95em;
			}
			.tool-card .tool-badge {
				display: inline-block;
				padding: 0.2em 0.7em;
				border-radius: 4px;
				font-size: 0.75em;
				font-weight: 700;
				letter-spacing: 0.05em;
				text-transform: uppercase;
				background: rgba(74, 125, 255, 0.15);
				color: var(--cat-eu4);
				border: 1px solid rgba(74, 125, 255, 0.3);
			}
			@media (max-width: 720px) {
				.tools-grid {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<h1>Tools</h1>
			<p class="subtitle">Interactive tools to help you understand Paradox grand strategy games.</p>
			<div class="tools-grid">
				<a class="tool-card" href="/tools/eu4-trade-map">
					<span class="tool-badge">EU4</span>
					<h3>EU4 Trade Node Map</h3>
					<p>Explore how trade value flows through EU4's node network.</p>
				</a>
			</div>
		</main>
		<Footer />
	</body>
</html>