---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('articles')).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const latest = posts.slice(0, 6);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				text-align: center;
				padding: 4em 1em;
				position: relative;
				overflow: hidden;
				border-radius: 16px;
				border: 1px solid var(--border-color);
				background: linear-gradient(135deg, #1a2233 0%, #0f1420 50%, #1a2233 100%);
				margin-bottom: 3em;
			}
			.hero::before {
				content: '';
				position: absolute;
				top: -50%;
				left: -50%;
				width: 200%;
				height: 200%;
				background: radial-gradient(circle at 30% 30%, rgba(212, 169, 78, 0.08) 0%, transparent 50%),
					radial-gradient(circle at 70% 70%, rgba(74, 125, 255, 0.06) 0%, transparent 50%);
				animation: heroGlow 8s ease-in-out infinite alternate;
			}
			@keyframes heroGlow {
				from {
					transform: translate(0, 0);
				}
				to {
					transform: translate(2%, 2%);
				}
			}
			.hero h1 {
				font-size: 3em;
				margin: 0 0 0.3em 0;
				background: linear-gradient(135deg, var(--accent) 0%, #f0d48a 50%, var(--accent) 100%);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
				position: relative;
				z-index: 1;
			}
			.hero p {
				font-size: 1.2em;
				color: var(--text-secondary);
				max-width: 600px;
				margin: 0 auto;
				position: relative;
				z-index: 1;
			}
			.categories {
				display: flex;
				justify-content: center;
				gap: 1em;
				flex-wrap: wrap;
				margin: 2em 0;
				position: relative;
				z-index: 1;
			}
			.categories a {
				padding: 0.75em 1.5em;
				border-radius: 8px;
				text-decoration: none;
				font-weight: 700;
				transition: transform 0.2s ease, box-shadow 0.2s ease;
				border: 1px solid;
			}
			.categories a:hover {
				transform: translateY(-2px);
				box-shadow: var(--box-shadow-hover);
			}
			.cat-eu5 {
				background: rgba(45, 212, 191, 0.1);
				color: var(--cat-eu5);
				border-color: rgba(45, 212, 191, 0.3);
			}
			.cat-eu4 {
				background: rgba(74, 125, 255, 0.1);
				color: var(--cat-eu4);
				border-color: rgba(74, 125, 255, 0.3);
			}
			.cat-ck3 {
				background: rgba(224, 82, 82, 0.1);
				color: var(--cat-ck3);
				border-color: rgba(224, 82, 82, 0.3);
			}
			.cat-comparisons {
				background: rgba(167, 139, 250, 0.1);
				color: var(--cat-comparisons);
				border-color: rgba(167, 139, 250, 0.3);
			}
			.latest {
				margin-top: 2em;
			}
			.latest h2 {
				text-align: center;
				margin-bottom: 1.5em;
				color: var(--text-primary);
			}
			.grid {
				display: grid;
				grid-template-columns: repeat(2, 1fr);
				gap: 1.5em;
			}
			.quiz-banner {
				margin: 2em 0 3em 0;
			}
			.quiz-banner a {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 1.5em;
				padding: 1.5em 2em;
				background: linear-gradient(135deg, rgba(212, 169, 78, 0.1) 0%, rgba(74, 125, 255, 0.05) 100%);
				border: 1px solid var(--border-color);
				border-radius: 12px;
				text-decoration: none;
				transition: border-color 0.2s ease, transform 0.2s ease;
			}
			.quiz-banner a:hover {
				border-color: var(--accent);
				transform: translateY(-2px);
			}
			.quiz-banner h3 {
				margin: 0 0 0.3em 0;
				color: var(--accent);
				font-size: 1.2em;
			}
			.quiz-banner p {
				margin: 0;
				color: var(--text-secondary);
				font-size: 0.95em;
			}
			.quiz-cta {
				white-space: nowrap;
				color: var(--accent);
				font-weight: 700;
				font-size: 1em;
			}
			@media (max-width: 720px) {
				.hero {
					padding: 2.5em 1em;
				}
				.hero h1 {
					font-size: 2em;
				}
				.grid {
					grid-template-columns: 1fr;
				}
				.quiz-banner a {
					flex-direction: column;
					text-align: center;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Grand Strategy Hub</h1>
				<p>
					In-depth guides and mechanics explainers for Europa Universalis IV, Europa
					Universalis V, and Crusader Kings III.
				</p>
				<div class="categories">
					<a class="cat-eu5" href="/category/eu5">EU5 Guides</a>
					<a class="cat-eu4" href="/category/eu4">EU4 Guides</a>
					<a class="cat-ck3" href="/category/ck3">CK3 Guides</a>
					<a class="cat-comparisons" href="/category/comparisons">Comparisons</a>
				</div>
			</section>
			<section class="quiz-banner">
				<a href="/quiz">
					<div>
						<h3>Which Paradox Game Should You Play?</h3>
						<p>Not sure whether to start with EU4, EU5, or CK3? Take our 30-second quiz and find out.</p>
					</div>
					<span class="quiz-cta">Take the Quiz →</span>
				</a>
			</section>
			<section class="latest">
				<h2>Latest Guides</h2>
				<div class="grid">
					{latest.map((post) => (
						<a class="article-card" href={`/blog/${post.data.slug}/`}>
							<span class={`cat-badge ${post.data.category.toLowerCase()}`}>{post.data.category}</span>
							<h4>{post.data.title}</h4>
							<p class="date">
								<FormattedDate date={post.data.date} />
							</p>
						</a>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>